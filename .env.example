# ---------------------------------------------------------------
# BRN Skins - variaveis de ambiente
# Copie para .env.local e preencha. Nunca commite .env.local.
# ---------------------------------------------------------------

# Numero do WhatsApp da loja (somente digitos, com DDI). Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Fonte de dados do catalogo: "demo" (padrao) ou "supabase" (quando configurado)
NEXT_PUBLIC_CATALOG_SOURCE=demo

# Supabase (futuro). A anon key e publica por design; a service role NUNCA vai para o frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Painel administrativo (somente servidor)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# CS2Inspect (visualizador 3D). Chave PÚBLICA por design: protegida pela lista de sites permitidos.
# Crie em cs2inspect.skin > menu da conta > API > New key (adicione localhost e o domínio da loja).
NEXT_PUBLIC_CS2INSPECT_KEY=
